# Required: from the NxtFireGuard dashboard.
AGGREGATOR_NAME=
AUTH_SECRET=
HEARTBEAT_IDENTIFIER=

DEBUG=false

HEARTBEAT_URL=https://heartbeat.nxtfireguard.de
NFG_TFA_CONTROLLER_URL=https://controller.collector.nxtfireguard.de
# Optional: overrides only the host of the update stream (wss://<host>/sync/ws/updates).
# NFG_TFA_CONTROLLER_HOST=
THREAT_LOG_COLLECTOR_URL=https://threat.collector.nxtfireguard.de
SKIP_VERIFY_TLS=false

# Generated container configs and the last settings from the dashboard.
NFG_STATE_DIR=./nfgtfa-state

# Only needed when "Run Logstash" is enabled for this aggregator.
ELASTICSEARCH_TARGETS='[{"url":"http://elasticsearch:9200","user":"elastic","pass":"changeme"}]'
